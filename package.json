{
	"name": "replace",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --include-env=false && vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --include-env=false && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"gen": "wrangler types --include-env=false",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx scripts/seed.ts",
		"db:reset": "tsx scripts/seed.ts",
		"deploy": "npm run build && wrangler deploy",
		"db:export": "tsx scripts/export-sql.ts",
		"db:migrate:remote": "wrangler d1 migrations apply replace-lba --remote",
		"db:seed:remote": "wrangler d1 execute replace-lba --remote --file=drizzle/seed-data.sql"
	},
	"devDependencies": {
		"@libsql/client": "^0.17.3",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.97.0",
		"xlsx": "^0.18.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.65.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.0"
	}
}
